# --- Prava (the one real rail; sandbox) -------------------------------------
# Left EMPTY on purpose. A placeholder that merely looks like a key (sk_test_…)
# passes the key-prefix check, so the rail would register and then 401 against
# the real sandbox on first use. Empty means the rail stays unconfigured and
# method="prava" returns a clean 503 — card rails work regardless. Paste a real
# sk_test_ key here to turn it on.
PRAVA_SECRET_KEY=
PRAVA_API_BASE=https://sandbox.api.prava.space
# Prava account that owns the passkey — required, no default. A synthetic user
# mints sessions fine and then fails verification hundreds of ms later
# (PASSKEY_REG_FAILED / FIDO_START_FAILED), far from the cause. Refuse early.
PAYOPTIMIZE_USER_ID=you@example.com
PAYOPTIMIZE_USER_EMAIL=you@example.com
# A live key (sk_live_) is refused unless this says so out loud. A sandbox key
# pointed at the live host (or vice versa) is refused too, with a sentence
# rather than the bare 401 the API would answer.
# PAYOPTIMIZE_ALLOW_LIVE=1

# --- Service -----------------------------------------------------------------
PAYOPTIMIZE_DB=payoptimize.sqlite3
PAYOPTIMIZE_ADMIN_TOKEN=change_me_long_random
PAYOPTIMIZE_PORT=8080
PAYOPTIMIZE_GENERATOR_TPS=2
# Optional: seed the sim/router RNG for deterministic rehearsals
PAYOPTIMIZE_SEED=

# --- Client side (MCP server / SDK / scripts/agent_demo.py) -------------------
PAYOPTIMIZE_API_URL=http://127.0.0.1:8080
PAYOPTIMIZE_API_KEY=pok_replace_me

# --- Ops agent (LLM; optional) ------------------------------------------------
# Left EMPTY on purpose: no key means the agent endpoints answer a clean 503
# and the trigger watcher never starts — payments work identically without it.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com
PAYOPTIMIZE_AGENT_MODEL=gpt-5
# auto: guarded actions execute immediately; propose: every action waits for a
# human at POST /admin/agent/actions/{id}
PAYOPTIMIZE_AGENT_AUTONOMY=auto
# Set to 0 to stop event-driven agent runs (incidents, stranded payments)
PAYOPTIMIZE_AGENT_TRIGGERS=1
